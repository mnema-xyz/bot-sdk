{
  "name": "@mnema-xyz/bot-sdk",
  "version": "3.1.3",
  "description": "Official TypeScript SDK for Mnema Talk bots: REST API with rate limits, gateway with resume and reconnects, slash commands, interactions, components and modals. No runtime dependencies.",
  "license": "MIT",
  "author": "Mnema <contact@mnema.xyz> (https://mnema.xyz)",
  "keywords": [
    "mnema",
    "mnema-talk",
    "bot",
    "bot-sdk",
    "chat",
    "gateway",
    "websocket",
    "slash-commands",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnema-xyz/bot-sdk-js.git"
  },
  "homepage": "https://mnema.xyz/developers/typescript-sdk/",
  "bugs": {
    "url": "https://github.com/mnema-xyz/bot-sdk-js/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-timeout=20000 \"test/**/*.test.ts\"",
    "test:contract": "node --test --test-timeout=60000 \"test/contract/*.test.ts\"",
    "prepack": "npm run build",
    "lint": "tools/lint/node_modules/.bin/eslint --max-warnings 0 .",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
