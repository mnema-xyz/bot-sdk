{
  "name": "@mnema-xyz/bot-sdk",
  "version": "3.1.1",
  "description": "Official TypeScript SDK for Mnema Talk bots: REST API, gateway, slash commands, components and modals.",
  "license": "AGPL-3.0-only",
  "keywords": [
    "mnema",
    "mnema-talk",
    "bot",
    "sdk",
    "gateway"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mnema-xyz/bot-sdk.git"
  },
  "homepage": "https://github.com/mnema-xyz/bot-sdk#readme",
  "bugs": {
    "url": "https://github.com/mnema-xyz/bot-sdk/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-timeout=20000 \"test/**/*.test.ts\"",
    "test:contract": "node --test --test-timeout=60000 \"test/contract/*.test.ts\"",
    "prepack": "npm run build",
    "lint": "tools/lint/node_modules/.bin/eslint --max-warnings 0 .",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm pack --dry-run"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
